# Copy to .env and fill in (tools/init-env.ps1 or tools/init-env.sh does it interactively).
# .env is ignored by Git: never commit it, never paste its values in chats or issues.

# Grafana login (user: admin)
GRAFANA_ADMIN_PASSWORD=change-me

# Telegram alerts: create a bot with @BotFather and take the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after sending the bot a message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How long Prometheus keeps metrics
PROMETHEUS_RETENTION=30d

# Local ports (all bound to 127.0.0.1). Change one if another program already uses it,
# for example GRAFANA_PORT=3001 when another Grafana runs on port 3000.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
